# Sumo Logic MCP Server Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.

# Required: Sumo Logic Access Key credentials
# Create at: Administration > Security > Access Keys
SUMO_ACCESS_ID=your-access-id-here
SUMO_ACCESS_KEY=your-access-key-here

# Required: Sumo Logic API base URL (includes /api suffix)
# Regional endpoints:
#   US1: https://api.sumologic.com/api
#   US2: https://api.us2.sumologic.com/api
#   EU:  https://api.eu.sumologic.com/api
#   AU:  https://api.au.sumologic.com/api
#   JP:  https://api.jp.sumologic.com/api
#   CA:  https://api.ca.sumologic.com/api
#   DE:  https://api.de.sumologic.com/api
#   IN:  https://api.in.sumologic.com/api
#   FED: https://api.fed.sumologic.com/api
SUMO_API_BASE_URL=https://api.us2.sumologic.com/api

# Optional: Default source category for opinionated query tools
SUMO_DEFAULT_SOURCE_CATEGORY=

# Optional: Maximum query time range in minutes (default: 1440 = 24 hours)
SUMO_MAX_QUERY_RANGE_MINUTES=1440

# Optional: Maximum number of results to return (default: 1000)
SUMO_MAX_RESULT_COUNT=1000

# Optional: Query timeout in seconds (default: 120)
SUMO_QUERY_TIMEOUT_SECONDS=120

# Optional: Log level (debug, info, warn, error) (default: info)
LOG_LEVEL=info
